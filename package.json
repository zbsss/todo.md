{
  "name": "todo.md",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node --test scripts/test-auto-refresh-helpers.mjs scripts/test-button-hover-stability.mjs scripts/test-editor-backdrop-close.mjs scripts/test-frontend-helpers.mjs scripts/test-task-selector-close.mjs scripts/test-todo-md-task-scripts.mjs",
    "build": "npm run typecheck && vite build",
    "test": "npm run test:rust",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked --all-features",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets --all-features -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "coverage:rust": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --locked --all-features --lcov --output-path src-tauri/lcov.info",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "lucide": "^1.48.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
